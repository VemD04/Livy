<Window x:Class="Livy.Views.SupportDeveloperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource About_SupportTitle}"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="380"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Window.Resources>
        <!-- Modern entrance scale and fade animation -->
        <Storyboard x:Key="DialogEntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.95" To="1.0"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.95" To="1.0"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource DialogEntranceStoryboard}" />
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True"
            Background="{DynamicResource BackgroundBrush}"
            Margin="12"
            RenderTransformOrigin="0.5,0.5"
            RenderOptions.ClearTypeHint="Enabled">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.4" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border CornerRadius="8" Width="26" Height="26" Background="#1AEF4444" BorderBrush="#33EF4444" BorderThickness="1" Margin="0,0,10,0">
                        <Path Data="{StaticResource HeartIcon}" Fill="#EF4444" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource About_SupportTitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" Style="{StaticResource SidebarButton}" Padding="16,0" Click="Close_Click" IsCancel="True">
                    <Path Data="{StaticResource CloseIcon}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="10" Height="10" />
                </Button>
            </Grid>

            <!-- Dialog Body -->
            <StackPanel Grid.Row="1" Margin="24,18,24,16" HorizontalAlignment="Center">
                <!-- Description -->
                <TextBlock Text="{DynamicResource About_SupportDesc}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           LineHeight="18"
                           Margin="0,0,0,16" />

                <!-- QRIS Poster Image -->
                <Border Width="220" CornerRadius="12"
                        Background="White"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                        Padding="6" ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Image Source="pack://application:,,,/Assets/qris.png"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform" />
                </Border>

                <!-- Thank you message -->
                <Border Background="#123B82F6" BorderBrush="#243B82F6" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" HorizontalAlignment="Stretch">
                    <TextBlock Text="{DynamicResource About_SupportThankYou}" FontSize="11"
                               Foreground="{DynamicResource AccentBrush}" FontStyle="Italic"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- Dialog Footer -->
            <Border Grid.Row="2" Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="22,12">
                <Button Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right"
                        Padding="24,8"
                        Click="Close_Click"
                        IsCancel="True">
                    <TextBlock Text="Tutup" FontSize="12" FontWeight="SemiBold" />
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
