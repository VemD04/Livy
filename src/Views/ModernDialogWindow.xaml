<Window x:Class="Livy.Views.ModernDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Livy"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="440"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Window.Resources>
        <!-- Modern entrance scale and fade animation -->
        <Storyboard x:Key="DialogEntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0"
                             Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.94" To="1.0"
                             Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.94" To="1.0"
                             Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Solid Danger Confirm Button -->
        <Style x:Key="DangerSolidButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource DialogEntranceStoryboard}" />
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True"
            Background="{DynamicResource BackgroundBrush}"
            Margin="12"
            RenderTransformOrigin="0.5,0.5"
            RenderOptions.ClearTypeHint="Enabled">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.4" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock x:Name="TitleTextBlock" Text="Livy"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" Style="{StaticResource SidebarButton}" Padding="16,0" Click="Close_Click">
                    <Path Data="{StaticResource CloseIcon}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="9" Height="9" />
                </Button>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="22,20,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border x:Name="IconBadge" Grid.Column="0"
                        Width="46" Height="46" CornerRadius="12"
                        VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="0,2,16,0">
                    <Path x:Name="IconPath"
                          Width="22" Height="22"
                          Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Message Texts -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingTextBlock"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <TextBlock x:Name="MessageTextBlock"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="20" />
                </StackPanel>
            </Grid>

            <!-- Actions Footer Bar -->
            <Border Grid.Row="2" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Secondary Button (Cancel / No) -->
                    <Button x:Name="SecondaryButton"
                            Content="{DynamicResource Dialog_Cancel}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="18,8"
                            MinWidth="80"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="SecondaryButton_Click" />

                    <!-- Primary Button (OK / Yes / Delete) -->
                    <Button x:Name="PrimaryButton"
                            Content="{DynamicResource Dialog_OK}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="18,8"
                            MinWidth="80"
                            IsDefault="True"
                            Click="PrimaryButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
