<Window x:Class="Livy.Views.AddWallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Livy.Views"
        Title="{DynamicResource AddDialog_Title}"
        Height="440" Width="580"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True"
            Margin="10"
            RenderOptions.ClearTypeHint="Enabled">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.3" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border CornerRadius="7" Width="28" Height="28" Margin="0,0,9,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="{DynamicResource AddDialog_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" Style="{StaticResource SidebarButton}" Padding="16,0" Click="Close_Click">
                    <Path Data="{StaticResource CloseIcon}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="10" Height="10" />
                </Button>
            </Grid>

            <!-- Drop Zone Area -->
            <Grid Grid.Row="1" Margin="24,20,24,16">
                <Grid x:Name="DropZoneGrid"
                      AllowDrop="True"
                      Cursor="Hand"
                      DragEnter="DropZone_DragEnter"
                      DragOver="DropZone_DragOver"
                      DragLeave="DropZone_DragLeave"
                      Drop="DropZone_Drop"
                      MouseLeftButtonUp="DropZone_Click">
                    
                    <!-- Dashed Border & Background -->
                    <Rectangle x:Name="DropZoneRect"
                               Stroke="{DynamicResource BorderBrush}"
                               StrokeDashArray="5 4"
                               StrokeThickness="2"
                               RadiusX="12" RadiusY="12"
                               Fill="{DynamicResource SecondaryBackgroundBrush}" />

                    <!-- Normal / Drag State Content -->
                    <StackPanel x:Name="NormalContent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <!-- Upload Icon in Circle Badge -->
                        <Border x:Name="IconBadge" Width="64" Height="64" CornerRadius="32"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path x:Name="UploadIconPath" Data="{StaticResource UploadIcon}"
                                  Fill="{DynamicResource AccentBrush}"
                                  Stretch="Uniform" Width="30" Height="30"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock x:Name="PromptTitleText"
                                   Text="{DynamicResource AddDialog_DragDropPrompt}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" FontSize="16"
                                   HorizontalAlignment="Center" Margin="0,0,0,6" />

                        <TextBlock x:Name="PromptSubText"
                                   Text="{DynamicResource AddDialog_ClickPrompt}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="13" FontWeight="Medium"
                                   HorizontalAlignment="Center" Margin="0,0,0,18" />

                        <!-- Format Badges -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border CornerRadius="6" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,4" Margin="3,0">
                                <TextBlock Text="MP4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Border CornerRadius="6" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,4" Margin="3,0">
                                <TextBlock Text="WEBM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Border CornerRadius="6" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,4" Margin="3,0">
                                <TextBlock Text="MKV" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Border CornerRadius="6" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,4" Margin="3,0">
                                <TextBlock Text="AVI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Border CornerRadius="6" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,4" Margin="3,0">
                                <TextBlock Text="MOV" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Processing State Overlay -->
                    <Grid x:Name="ProcessingOverlay" Visibility="Collapsed" Background="{DynamicResource SecondaryBackgroundBrush}">
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="36,24"
                                Margin="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.25" Color="#000000" />
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Large Spinner Container with glowing icon -->
                                <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <controls:LoadingSpinner Diameter="56" StrokeThickness="4" Color="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Path Data="{StaticResource WallpapersIcon}"
                                          Fill="{DynamicResource AccentBrush}"
                                          Width="20" Height="20"
                                          Stretch="Uniform"
                                          Opacity="0.85"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Title -->
                                <TextBlock Text="{DynamicResource AddDialog_Importing}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,0,0,4" />

                                <!-- File Name being processed -->
                                <TextBlock x:Name="ProcessingDetailText"
                                           Text=""
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="13" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="360"
                                           HorizontalAlignment="Center" Margin="0,0,0,4" />

                                <!-- Subtitle details -->
                                <TextBlock Text="{DynamicResource AddDialog_ExtractingDetails}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Center" Margin="0,0,0,16" />

                                <!-- Indeterminate Progress Bar -->
                                <ProgressBar IsIndeterminate="True"
                                             Width="220" Height="4"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource SecondaryBackgroundBrush}"
                                             BorderThickness="0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Bottom Action Row -->
            <Grid Grid.Row="2" Margin="24,0,24,18">
                <TextBlock Text="{DynamicResource AddDialog_SupportedFormats}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CloseButton"
                            Content="{DynamicResource AddDialog_Close}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="16,8" Margin="0,0,8,0"
                            Click="Close_Click" />
                    <Button x:Name="BrowseButton"
                            Content="{DynamicResource Wallpapers_Add}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="18,8"
                            Click="Browse_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
