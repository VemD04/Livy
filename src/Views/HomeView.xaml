<UserControl x:Class="Livy.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Livy.Views"
             mc:Ignorable="d"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Style="{StaticResource PageTransitionStyle}"
                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
        <StackPanel Margin="32,24,32,40">

            <!-- ================= ACTIVE WALLPAPER SECTION ================= -->
            <TextBlock Text="{DynamicResource Home_CurrentWallpaper}" Style="{StaticResource HeaderText}" Margin="0,0,0,16" />

            <!-- Active Wallpaper Card (When Active) -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,32"
                    Visibility="{Binding HasActiveWallpaper, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Preview Thumbnail / Live Video Playback (Click to Preview Fullscreen) -->
                    <Border Grid.Column="0" Width="260" Height="146" CornerRadius="10" ClipToBounds="True"
                            Background="{DynamicResource SecondaryBackgroundBrush}"
                            Cursor="Hand"
                            ToolTip="{DynamicResource Home_ClickToPreview}"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            RenderOptions.EdgeMode="Unspecified"
                            SnapsToDevicePixels="True"
                            MouseLeftButtonUp="ActiveThumbnail_MouseLeftButtonUp">
                        <Grid>
                            <!-- Thumbnail Image (shown as poster before video starts or fallback) -->
                            <Image Source="{Binding ActiveWallpaper.Thumbnail}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <!-- Live Active Video Preview Player with HighQuality Scaling -->
                            <MediaElement x:Name="ActiveMediaElement"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Manual"
                                          IsMuted="True"
                                          Stretch="UniformToFill"
                                          RenderOptions.BitmapScalingMode="HighQuality"
                                          RenderOptions.EdgeMode="Unspecified"
                                          MediaOpened="ActiveMediaElement_MediaOpened"
                                          MediaEnded="ActiveMediaElement_MediaEnded"
                                          MediaFailed="ActiveMediaElement_MediaFailed" />

                            <!-- Fallback Icon if Thumbnail Not Loaded -->
                            <Path Data="{StaticResource WallpapersIcon}" Fill="{DynamicResource TextSecondaryBrush}"
                                  Width="40" Height="40" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveWallpaper.Thumbnail}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <!-- Preview Hint Overlay -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                                    Background="#80000000" CornerRadius="5" Padding="6,3">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource MaximizeIcon}" Fill="White" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Wallpapers_Preview}" Foreground="White" FontSize="10" FontWeight="Medium" />
                                </StackPanel>
                            </Border>

                            <!-- Duration Badge Overlay -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                    Background="#B3000000" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="11" FontWeight="Medium" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Details & Controls -->
                    <StackPanel Grid.Column="1" Margin="24,4,0,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WallpaperName}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Meta Chips -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Resolution}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Fps}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="{Binding Duration}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Status Indicator -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource DotIcon}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,8,0">
                                <Path.Fill>
                                    <SolidColorBrush Color="{Binding StatusColor}" />
                                </Path.Fill>
                            </Path>
                            <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active Wallpaper Card (When None Active) -->
            <Border Margin="0,0,0,32">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActiveWallpaper}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource SecondaryBackgroundBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Path Data="{StaticResource WallpapersIcon}" Fill="{DynamicResource TextSecondaryBrush}"
                              Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Home_EmptyTitle}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource Home_EmptyDesc}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= WALLPAPER LIBRARY SECTION ================= -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{DynamicResource Wallpapers_Title}" Style="{StaticResource HeaderText}" VerticalAlignment="Center" />

                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding AddWallpaperCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource AddIcon}" Width="14" Height="14" Fill="White" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Wallpapers_Add}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Wallpaper Grid List -->
            <ItemsControl x:Name="WallpaperList"
                          ItemsSource="{Binding Wallpapers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Card outer border (for shadow + ClipToBounds) -->
                        <Border x:Name="Card"
                                Width="240"
                                VerticalAlignment="Top"
                                Margin="0,0,16,16"
                                CornerRadius="14"
                                ClipToBounds="False">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" Opacity="0.22" ShadowDepth="3" Color="#000000" />
                            </Border.Effect>

                            <Border.ContextMenu>
                                <ContextMenu Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <MenuItem Header="Edit" Click="EditWallpaperMenuItem_Click" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource EditIcon}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Background="{DynamicResource BorderBrush}" />
                                    <MenuItem Header="Hapus" Click="DeleteWallpaperMenuItem_Click" Foreground="{DynamicResource DangerBrush}">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource DeleteIcon}" Fill="{DynamicResource DangerBrush}" Stretch="Uniform" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>

                            <!-- Inner border clips the rounded thumbnail -->
                            <Border x:Name="InnerCard"
                                    CornerRadius="14"
                                    Background="{DynamicResource CardBrush}"
                                    BorderThickness="0"
                                    ClipToBounds="True"
                                    RenderOptions.ClearTypeHint="Enabled"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="145" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- ── Thumbnail + Hover Overlay ── -->
                                    <Grid Grid.Row="0">
                                        <Grid.OpacityMask>
                                            <VisualBrush>
                                                <VisualBrush.Visual>
                                                    <Border Background="Black"
                                                            CornerRadius="14,14,0,0"
                                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" />
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Grid.OpacityMask>
                                        <!-- Background fill (while thumbnail loads) -->
                                        <Rectangle Fill="{DynamicResource SecondaryBackgroundBrush}" />

                                        <!-- Thumbnail image -->
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"
                                               StretchDirection="Both" />

                                        <!-- Hover overlay: dark scrim -->
                                        <Border x:Name="HoverOverlay"
                                                Background="#BB000000"
                                                CornerRadius="14,14,0,0"
                                                Opacity="0" />

                                        <!-- Preview button (shown on hover, centered) -->
                                        <Button x:Name="PreviewBtn"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryButton}"
                                                Opacity="0"
                                                Click="PreviewButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource PlayIcon}"
                                                      Width="11" Height="11"
                                                      Stretch="Uniform"
                                                      Fill="{DynamicResource TextPrimaryBrush}"
                                                      Margin="0,0,6,0" />
                                                <TextBlock Text="{DynamicResource Wallpapers_Preview}" />
                                            </StackPanel>
                                        </Button>

                                        <!-- "Diterapkan" active badge (top-right) -->
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,10,10,0"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Diterapkan"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="White" />
                                        </Border>

                                        <!-- Delete button (top-left, shown on hover) -->
                                        <Border x:Name="DeleteBtn"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="10,10,0,0"
                                                Width="28" Height="28"
                                                CornerRadius="14"
                                                Background="#CC0B0E17"
                                                Cursor="Hand"
                                                Opacity="0"
                                                ToolTip="Hapus"
                                                MouseLeftButtonUp="DeleteButton_Click">
                                            <Path Data="{StaticResource DeleteIcon}" 
                                                  Fill="#FF6B6B" 
                                                  Stretch="Uniform" 
                                                  Width="12" Height="12"
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Applying Loading Overlay on Thumbnail -->
                                        <Border x:Name="ApplyingThumbnailOverlay"
                                                Background="#D00B0E17"
                                                CornerRadius="14,14,0,0"
                                                Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <controls:LoadingSpinner Diameter="34" StrokeThickness="3.2" Color="{DynamicResource AccentBrush}" Margin="0,0,0,8" HorizontalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource Wallpapers_Applying}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- ── Card Bottom: Info + Apply Button / Active Status ── -->
                                    <StackPanel Grid.Row="1" Margin="12,10,12,12">
                                        <!-- File name -->
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FileName}"
                                                   Margin="0,0,0,4" />

                                        <!-- Resolution • Duration -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Resolution}"
                                                       Style="{StaticResource CaptionText}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="•"
                                                       FontSize="8"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="6,0,6,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DurationText}"
                                                       Style="{StaticResource CaptionText}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Applying status button (visible while this wallpaper is applying) -->
                                        <Border Background="{DynamicResource AccentBrush}"
                                                CornerRadius="10"
                                                Padding="0,8"
                                                HorizontalAlignment="Stretch"
                                                Opacity="0.9"
                                                Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <controls:LoadingSpinner Diameter="13" StrokeThickness="2.2" Color="White" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource Wallpapers_Applying}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Apply button: visible only when NOT active and NOT applying -->
                                        <Button Padding="0,8"
                                                FontSize="12"
                                                Click="ApplyButton_Click"
                                                IsEnabled="{Binding DataContext.IsApplyingAny, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolInverseConverter}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsApplying}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource CheckIcon}"
                                                      Width="11" Height="11"
                                                      Stretch="Uniform"
                                                      Fill="White"
                                                      Margin="0,0,6,0" />
                                                <TextBlock Text="{DynamicResource Wallpapers_Apply}" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Active status indicator (visible only when ACTIVE and NOT applying) -->
                                        <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="0,8"
                                                HorizontalAlignment="Stretch">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsActive}" Value="True" />
                                                                <Condition Binding="{Binding IsApplying}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Data="{StaticResource CheckIcon}"
                                                      Width="11" Height="11"
                                                      Stretch="Uniform"
                                                      Fill="{DynamicResource SuccessBrush}"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource Preview_Active}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- ── Border stroke rendered ON TOP of image and content ── -->
                                    <Border x:Name="HighlightBorder"
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            CornerRadius="14"
                                            BorderThickness="1.5"
                                            IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsApplying}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=InnerCard}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>

                                <!-- Hover animations on inner Border -->
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="PreviewBtn"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="DeleteBtn"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="PreviewBtn"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="DeleteBtn"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
