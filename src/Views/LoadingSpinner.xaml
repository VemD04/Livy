<UserControl x:Class="Livy.Views.LoadingSpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="SpinnerRoot"
             IsVisibleChanged="Root_IsVisibleChanged"
             Loaded="Root_Loaded"
             Unloaded="Root_Unloaded">
    <Viewbox x:Name="ViewboxRoot"
             Width="{Binding Diameter, ElementName=SpinnerRoot}"
             Height="{Binding Diameter, ElementName=SpinnerRoot}">
        <Grid Width="24" Height="24">
            <!-- Background faint track ring -->
            <Ellipse x:Name="BackgroundEllipse"
                     Width="20" Height="20"
                     Opacity="0.18"
                     Stroke="{Binding Color, ElementName=SpinnerRoot}"
                     StrokeThickness="{Binding StrokeThickness, ElementName=SpinnerRoot}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />

            <!-- Spinning foreground arc (225 degrees with rounded caps) -->
            <Path x:Name="SpinnerArc"
                  Data="M 12,2 A 10,10 0 1,1 4.93,19.07"
                  Stroke="{Binding Color, ElementName=SpinnerRoot}"
                  StrokeThickness="{Binding StrokeThickness, ElementName=SpinnerRoot}"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <RotateTransform x:Name="SpinnerTransform" Angle="0" />
                </Path.RenderTransform>
            </Path>
        </Grid>
    </Viewbox>
</UserControl>
