<Window x:Class="Livy.Views.EditWallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource EditDialog_Title}" Height="440" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True"
            Background="{DynamicResource BackgroundBrush}"
            Margin="10"
            RenderOptions.ClearTypeHint="Enabled">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.3" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border CornerRadius="7" Width="28" Height="28" Margin="0,0,9,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="{DynamicResource EditDialog_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" Style="{StaticResource SidebarButton}" Padding="16,0" Click="Close_Click">
                    <Path Data="{StaticResource CloseIcon}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="10" Height="10" />
                </Button>
            </Grid>

            <!-- Content Area -->
            <StackPanel Grid.Row="1" Margin="24,20,24,16">
                <!-- File Name Input -->
                <TextBlock Text="{DynamicResource EditDialog_Name}" Style="{StaticResource SubHeaderText}" FontSize="13" Margin="0,0,0,8" />
                <TextBox x:Name="FileNameInput"
                         Style="{StaticResource FlatTextBox}"
                         Padding="12,10"
                         FontSize="13"
                         Margin="0,0,0,20" />

                <!-- Loop Mode Selection -->
                <TextBlock Text="{DynamicResource EditDialog_LoopMode}" Style="{StaticResource SubHeaderText}" FontSize="13" Margin="0,0,0,10" />
                <StackPanel Orientation="Vertical">
                    <RadioButton x:Name="RadioPingPong" Content="{DynamicResource Home_LoopPingPong}" Style="{StaticResource SettingsRadioButton}" Margin="0,0,0,8" />
                    <RadioButton x:Name="RadioSeamless" Content="{DynamicResource Home_LoopCrossfade}" Style="{StaticResource SettingsRadioButton}" Margin="0,0,0,8" />
                    <RadioButton x:Name="RadioStandard" Content="{DynamicResource Home_LoopStandard}" Style="{StaticResource SettingsRadioButton}" />
                </StackPanel>
            </StackPanel>

            <!-- Bottom Actions -->
            <Border Grid.Row="2" Background="{DynamicResource SecondaryBackgroundBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0">
                    <Button Content="{DynamicResource EditDialog_Cancel}" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="0,0,10,0" Click="Close_Click" IsCancel="True" />
                    <Button Content="{DynamicResource EditDialog_Save}" Style="{StaticResource PrimaryButton}" Padding="20,8" Click="Save_Click" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
