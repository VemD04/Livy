<Window x:Class="Livy.Views.WallpaperPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:controls="clr-namespace:Livy.Views"
        Title="{DynamicResource Preview_Title}"
        Height="580" Width="880"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border CornerRadius="7" Width="28" Height="28" Margin="0,0,9,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock x:Name="TitleText" Text="{DynamicResource Preview_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" Style="{StaticResource SidebarButton}" Padding="16,0" Click="Close_Click">
                    <Path Data="{StaticResource CloseIcon}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="10" Height="10" />
                </Button>
            </Grid>

            <!-- Video Player Display Area -->
            <Grid Grid.Row="1" Background="Black">
                <vlc:VideoView x:Name="VideoView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <!-- Fallback / Loading Text -->
                <TextBlock x:Name="LoadingText" Text="Loading video..." Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Visibility="Collapsed" />
            </Grid>

            <!-- Bottom Control / Action Bar -->
            <Border Grid.Row="2" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Wallpaper Metadata -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="WallpaperFileNameText" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="MonitorBadge" Background="{DynamicResource CardBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" Visibility="Collapsed">
                                <TextBlock x:Name="MonitorText" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock x:Name="ResolutionText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock x:Name="FpsText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="4" Padding="6,2">
                                <TextBlock x:Name="DurationText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Active Badge if this wallpaper is already applied -->
                        <Border x:Name="ActiveBadge" Background="#10B981" CornerRadius="6" Padding="12,6" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource DotIcon}" Fill="White" Width="6" Height="6" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Preview_Active}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Apply Button if not already applied -->
                        <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}"
                                Click="Apply_Click" Margin="0,0,8,0" Padding="20,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:LoadingSpinner x:Name="ApplySpinner" Diameter="13" StrokeThickness="2.2" Color="White" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center" />
                                <TextBlock x:Name="ApplyButtonText" Text="{DynamicResource Preview_Apply}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Close Button -->
                        <Button Content="{DynamicResource Preview_Close}" Style="{StaticResource SecondaryButton}"
                                Click="Close_Click" Padding="16,8" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
