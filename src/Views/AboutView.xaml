<UserControl x:Class="Livy.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource PageTransitionStyle}">
        <StackPanel HorizontalAlignment="Center" MaxWidth="680" Margin="24,16,24,32">

            <!-- ================= HERO & DEVELOPER CARD ================= -->
            <Border Style="{StaticResource CardStyle}" Padding="28,24" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Row: App Logo & Info -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- App Logo Squircle with Soft Glow -->
                        <Border Grid.Column="0" Width="76" Height="76" CornerRadius="18"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                ClipToBounds="True" Margin="0,0,20,0" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/logo.png"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <!-- Title, Tagline & Version Badges -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding AppName}" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                                <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Version}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource About_Tagline}" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontStyle="Italic" />
                        </StackPanel>
                    </Grid>

                    <!-- Divider -->
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,20" />

                    <!-- Developer Profile & GitHub Button -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Developer Info -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource About_Developer}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding DeveloperName}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <!-- Actions: GitHub Button & Support Developer Link -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- GitHub Button -->
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding OpenGitHubCommand}" Padding="16,8" Cursor="Hand" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GitHubIcon}" Fill="White" Width="14" Height="14"
                                          Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource About_VisitGitHub}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Path Data="{StaticResource ExternalLinkIcon}" Fill="White" Width="9" Height="9"
                                          Stretch="Uniform" VerticalAlignment="Center" Opacity="0.8" />
                                </StackPanel>
                            </Button>

                            <!-- Support Developer Link (Small text button underneath) -->
                            <Button Style="{StaticResource TextLinkButton}"
                                    Command="{Binding ShowSupportCommand}"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    Cursor="Hand"
                                    ToolTip="{DynamicResource About_SupportTitle}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource HeartIcon}" Fill="#EF4444" Width="11" Height="11"
                                          Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource About_SupportTitle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextDecorations="Underline"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= WALLPAPER GUIDE SECTION ================= -->
            <TextBlock Text="{DynamicResource About_GuideTitle}" Style="{StaticResource SubHeaderText}" Margin="4,8,0,12" />

            <!-- Guide Step 1: Add -->
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource SecondaryBackgroundBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Path Data="{StaticResource AddIcon}" Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource About_CrudCreateTitle}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <TextBlock Text="{DynamicResource About_CrudCreateDesc}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Guide Step 2: Read -->
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource SecondaryBackgroundBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Path Data="{StaticResource PlayIcon}" Fill="{DynamicResource SuccessBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource About_CrudReadTitle}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <TextBlock Text="{DynamicResource About_CrudReadDesc}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Guide Step 3: Update -->
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource SecondaryBackgroundBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Path Data="{StaticResource EditIcon}" Fill="#F59E0B" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource About_CrudUpdateTitle}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <TextBlock Text="{DynamicResource About_CrudUpdateDesc}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Guide Step 4: Delete -->
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource SecondaryBackgroundBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Path Data="{StaticResource DeleteIcon}" Fill="{DynamicResource DangerBrush}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource About_CrudDeleteTitle}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <TextBlock Text="{DynamicResource About_CrudDeleteDesc}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= PENJELASAN TENTANG APLIKASI ================= -->
            <TextBlock Text="{DynamicResource About_AppInfoTitle}" Style="{StaticResource SubHeaderText}" Margin="4,12,0,12" />

            <Border Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,0,0,24">
                <StackPanel>
                    <!-- App Intro Summary with Logo -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                                Background="{DynamicResource SecondaryBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Margin="0,0,14,0" VerticalAlignment="Top" ClipToBounds="True">
                            <Image Source="pack://application:,,,/Assets/logo.png"
                                   RenderOptions.BitmapScalingMode="HighQuality" Margin="6" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Livy" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                <Border Background="#1A3C7BFB" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="Live Wallpaper Engine" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource About_AppInfoDesc}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16" />

                    <!-- Engine & Technologies Section -->
                    <TextBlock Text="{DynamicResource About_AppEnginesTitle}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,10" />

                    <WrapPanel Margin="0,0,0,4">
                        <!-- LibVLC -->
                        <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="7" Height="7" CornerRadius="3.5" Background="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="LibVLCSharp" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Background="#1AF59E0B" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource About_EngineVideoPlayer}" FontSize="9.5" FontWeight="Medium" Foreground="#F59E0B" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- FFmpeg -->
                        <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="7" Height="7" CornerRadius="3.5" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="FFmpeg" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Background="#1A10B981" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource About_EngineVideoProc}" FontSize="9.5" FontWeight="Medium" Foreground="#10B981" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Direct3D 11 -->
                        <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="7" Height="7" CornerRadius="3.5" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Direct3D 11" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Background="#1A3C7BFB" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource About_EngineHwAccel}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- .NET 10 / WPF -->
                        <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="7" Height="7" CornerRadius="3.5" Background="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text=".NET 10 • WPF" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Background="#1A8B5CF6" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource About_EngineFramework}" FontSize="9.5" FontWeight="Medium" Foreground="#8B5CF6" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Win32 Shell API -->
                        <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="7" Height="7" CornerRadius="3.5" Background="#06B6D4" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Win32 Shell API" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Background="#1A06B6D4" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource About_EngineDesktopHook}" FontSize="9.5" FontWeight="Medium" Foreground="#06B6D4" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
