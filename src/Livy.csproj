<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyName>Livy</AssemblyName>
    <RootNamespace>Livy</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Size and Resource Optimization -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX64ExcludeFiles>hrtfs\%2A%2A;lua\%2A%2A</VlcWindowsX64ExcludeFiles>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.9.3" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.3" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\qris.png" />
  </ItemGroup>

  <Target Name="GenerateMissingIntelliSenseFiles" AfterTargets="MarkupCompilePass2">
    <ItemGroup>
      <GeneratedBamlFiles Include="$(IntermediateOutputPath)**\*.g.cs" />
    </ItemGroup>
    <Copy SourceFiles="@(GeneratedBamlFiles)"
          DestinationFiles="@(GeneratedBamlFiles->'%(RootDir)%(Directory)%(Filename).i.cs')"
          Condition="Exists('%(FullPath)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GeneratedBamlFiles)"
          DestinationFolder="$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\Views\"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GeneratedBamlFiles->'%(RootDir)%(Directory)%(Filename).i.cs')"
          DestinationFolder="$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\Views\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
